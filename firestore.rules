rules_version = '2';

// 기본 원칙: 명시적으로 허용한 것 외에는 모두 거부.
// 일기는 users/{uid}/entries/{entryId} 에 저장되며, 로그인한 본인만 읽고 쓸 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/entries/{entryId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['entry_date','title','content','mood','weather','created_at','updated_at'])
          && d.entry_date is string && d.entry_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.title is string   && d.title.size() <= 200
          && d.content is string && d.content.size() <= 100000
          && d.mood in ['', 'happy', 'calm', 'soso', 'sad', 'angry', 'tired']
          && d.weather is string && d.weather.size() <= 20
          && d.created_at is timestamp
          && d.updated_at == request.time;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner() && validEntry() && request.resource.data.created_at == request.time;
      allow update: if isOwner() && validEntry()
                    && request.resource.data.created_at == resource.data.created_at;
    }

    // 그 밖의 모든 경로는 접근 불가
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
